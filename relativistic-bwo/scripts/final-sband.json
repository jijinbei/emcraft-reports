[
 {
  "command": "geometry.import",
  "params": {
   "path": "../model/sband.sc",
   "materials": {
    "vacuum": "interior"
   }
  }
 },
 {
  "command": "project.analysis",
  "params": {
   "kind": "particles"
  }
 },
 {
  "command": "particles.magnetic",
  "params": {
   "b": [
    0,
    0,
    2.5
   ],
   "end": 290.0,
   "fall": 10
  }
 },
 {
  "command": "particles.beam",
  "params": {
   "face": "z-",
   "current": 6875.0,
   "energy": 550000.0,
   "radius": 30.5,
   "inner": 28.5,
   "rise": 2000
  }
 },
 {
  "command": "particles.open",
  "params": {
   "face": "z+"
  }
 },
 {
  "command": "particles.probe",
  "params": {
   "at": [
    33,
    0,
    155.0
   ]
  }
 },
 {
  "command": "particles.output",
  "params": {
   "at": 385.0
  }
 },
 {
  "command": "solve.particles",
  "params": {
   "time": 60,
   "cell": 1.5,
   "axisymmetric": true,
   "fine": 8,
   "frames": 30
  }
 },
 {
  "command": "results.particles.export",
  "params": {
   "path": "../results/final-sband-history.csv"
  }
 },
 {
  "command": "results.particles.export",
  "params": {
   "path": "../results/final-sband-probes.csv",
   "what": "probes"
  }
 },
 {
  "command": "results.particles.export",
  "params": {
   "path": "../results/final-sband-particles.csv",
   "what": "particles"
  }
 },
 {
  "command": "results.particles.export",
  "params": {
   "path": "../results/final-sband-frames.csv",
   "what": "frames"
  }
 },
 {
  "command": "results.particles.export",
  "params": {
   "path": "../results/final-sband-maps.csv",
   "what": "maps"
  }
 }
]
